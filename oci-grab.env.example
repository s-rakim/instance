# Copy to ~/.config/oci-grab.env and fill in. Read by the systemd unit.
#   chmod 600 ~/.config/oci-grab.env    -- it holds your Discord webhook
#
# Get the OCIDs with:  ./oci-grab.sh discover

COMPARTMENT_ID=ocid1.tenancy.oc1..CHANGEME
SUBNET_ID=ocid1.subnet.oc1.REGION.CHANGEME
IMAGE_ID=ocid1.image.oc1.REGION.CHANGEME

# The .pub, not the private key.
SSH_KEY=/home/YOURUSER/.ssh/oci_arm.pub

SHAPE=VM.Standard.A1.Flex
OCPUS=1
MEM_GB=6
DISPLAY_NAME=docker-host

# 0 = hunt until an instance lands. Safe here because the script checks whether
# one already exists before every run and exits when it finds one.
MAX_TRIES=0

# ~7 min sleep; the launch call adds ~2 min, so attempts land ~8.9 min apart.
# Do not go below 20s -- but note that rate was never the real hazard. Accounts
# have been flagged on cumulative volume at intervals as gentle as 10 minutes
# (mohankumarpaluru/oracle-freetier-instance-creation#75). Running 24/7 is
# roughly 160 attempts/day, above that case's ~144. Raise these if you would
# rather trade coverage for a lower total:
#   MIN_SLEEP=390  MAX_SLEEP=450   ->  ~160/day   (24/7 default)
#   MIN_SLEEP=840  MAX_SLEEP=960   ->   ~80/day
MIN_SLEEP=390
MAX_SLEEP=450

# Optional.
DISCORD_WEBHOOK=
