# Copy to hunt.env and fill in. hunt.env is gitignored; never commit it.
# Get the three OCIDs from: ./oci-grab.sh discover

COMPARTMENT_ID=
SUBNET_ID=                # a PUBLIC subnet, so the instance gets a public IP
IMAGE_ID=                 # an aarch64 Ubuntu image for VM.Standard.A1.Flex
SSH_KEY=~/.ssh/oci_arm.pub

# 1 OCPU / 6 GB lands far more often than 4 / 24 and is plenty for the sync server
OCPUS=1
MEM_GB=6

# Seconds between attempts. 480 = every 8 minutes.
INTERVAL=480

# Notifications, either or both. Leave blank for none.
# ntfy: install the ntfy app, subscribe to a long random topic name, put it here.
NTFY_URL=
DISCORD_WEBHOOK=
